# SQL Server (same Prisma-style URL used by the Next.js QMS)
DATABASE_URL="sqlserver://localhost:1433;database=qms;user=sa;password=Test@12345;encrypt=true;trustServerCertificate=true"

ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"
# Rating SMS link. false appends /rating/:ticketId to FEEDBACK_URL (or APP_URL / ORIGIN).
# true sends FEEDBACK_URL exactly as written.
FEEDBACK_URL="http://192.168.1.192:4200"
CUSTOM_FEEDBACK_LINK=false
ALLOWED_ORIGINS=*

# iron-session (32+ characters). Keep this stable across restarts.
SESSION_PASSWORD="complex_password_at_least_32_characters_long"
COOKIE_SECURE="false"

# Public feedback / rating API token (also set client-side as RATING_API_SECRET in public-config)
RATING_API_SECRET="Ihavekeptitasecret"

# ---------------------------------------------------------------------------
# SMS — SMS_SETUP selects the gateway:
#   development — VMS POST { senderId, message, contact } with header x-api-key
#   production  — DFCU GET dfcusms.php/dfcuwrapper/SMSAPIX
# ---------------------------------------------------------------------------
SMS_SETUP=development
SMS_API_KEY="vms_56319a13c258164c38897aacc2e48ed9df904782a407d67fda1fb2ef8a48ec1d"
SMS_SENDER_ID="7787"
SMS_ENDPOINT="https://vmsapi.nesscom.net:9443/send"
# Production DFCU gateway (used only when SMS_SETUP=production)
DFCU_SMS_BASE_URL=
DFCU_SMS_USERNAME=
DFCU_SMS_PASSWORD=
DFCU_SMS_API_ID=
DFCU_SMS_FROM=
# Optional. Defaults to TRANSACTIONAL when empty.
DFCU_SMS_MESSAGE_TYPE=
# Set to "false" only if the gateway cert chain cannot be verified in your environment
VERIFY_TLS=true

# database | ldap | hybrid
AUTH_METHOD="database"
USE_LDAP="false"

LDAP_URL="ldaps://192.168.1.5:636"
LDAP_BASE_DN="DC=dev,DC=local"
LDAP_DOMAIN="dev.local"
LDAP_TIMEOUT="5000"
LDAP_CONNECT_TIMEOUT="10000"
LDAP_REJECT_UNAUTHORIZED="false"

LOG_LEVEL="info"

# Allow SSR Host header for LAN IP access (use * for any host in dev)
NG_ALLOWED_HOSTS=*
HOST=0.0.0.0
