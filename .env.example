# Copy to .env and fill in real values. Do not commit .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQL Server connection string used by Drizzle.
# Format: sqlserver://HOST:1433;database=DB;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=qms;user=sa;password=change-me;encrypt=true;trustServerCertificate=true"

# ---------------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------------

# Browser origin of this app (scheme + host + port, no trailing path).
ORIGIN="http://localhost:4200"

# Same base URL, used as a fallback when building links.
APP_URL="http://localhost:4200"

# Link placed in the rating SMS sent when a ticket is marked Served.
# When CUSTOM_FEEDBACK_LINK=false, the app appends /rating/:ticketId
# (and falls back to APP_URL, then ORIGIN, if this is empty).
# When CUSTOM_FEEDBACK_LINK=true, this value is sent exactly as written.
FEEDBACK_URL="http://localhost:4200"

# false (or unset) — rating SMS uses this app's /rating/:ticketId page.
# true — rating SMS sends FEEDBACK_URL unchanged (company's own feedback page).
# If true and FEEDBACK_URL is empty, the rating SMS is skipped.
CUSTOM_FEEDBACK_LINK=false

# Origins allowed to call the public rating API without the rating token.
# * allows any origin. Otherwise a comma-separated list of origin prefixes.
ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Session and cookies
# ---------------------------------------------------------------------------

# iron-session secret. Must be at least 32 characters. Keep it stable across restarts.
SESSION_PASSWORD="change-me-to-a-secret-at-least-32-characters"

# true sends the session cookie only over HTTPS. false allows HTTP (local dev).
# If unset, secure cookies follow NODE_ENV=production.
COOKIE_SECURE=false

# Shared secret for the public feedback / rating API (header x-rating-token).
# Must match RATING_API_SECRET in src/app/core/public-config.ts.
RATING_API_SECRET="change-me"

# ---------------------------------------------------------------------------
# SMS
# ---------------------------------------------------------------------------

# Which gateway sends SMS.
#   development (or unset) — VMS (SMS_API_KEY, SMS_SENDER_ID, SMS_ENDPOINT)
#   production              — DFCU SMSAPIX (DFCU_SMS_* below)
# Any other value fails the send instead of picking a gateway.
SMS_SETUP=development

# VMS gateway. Required when SMS_SETUP is development.
# POST JSON { senderId, message, contact } with header x-api-key.
SMS_API_KEY="vms_..."
SMS_SENDER_ID="7787"
SMS_ENDPOINT="https://vmsapi.nesscom.net:9443/send"

# DFCU gateway. Required when SMS_SETUP=production.
# BASE_URL is the origin only; the app appends dfcusms.php/dfcuwrapper/SMSAPIX.
# Query params: USERNAME, PASSWORD, api_id, from, MSISDN, MESSAGE, MESSAGE_TYPE.
DFCU_SMS_BASE_URL=
DFCU_SMS_USERNAME=
DFCU_SMS_PASSWORD=
DFCU_SMS_API_ID=
DFCU_SMS_FROM=

# Optional DFCU message priority: OTP, TRANSACTIONAL, or PROMOTIONAL.
# Empty defaults to TRANSACTIONAL.
DFCU_SMS_MESSAGE_TYPE=

# Verify TLS certificates on SMS gateway requests.
# Set to false only when the gateway certificate cannot be verified.
VERIFY_TLS=true

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# How agents sign in: database, ldap, or hybrid.
AUTH_METHOD="database"

# true also enables LDAP (same effect as AUTH_METHOD=ldap or hybrid).
USE_LDAP=false

# LDAP settings. Used when AUTH_METHOD is ldap or hybrid, or USE_LDAP=true.
LDAP_URL="ldaps://ldap.example.com:636"
LDAP_BASE_DN="DC=example,DC=com"
LDAP_DOMAIN="example.com"
# Milliseconds.
LDAP_TIMEOUT="5000"
LDAP_CONNECT_TIMEOUT="10000"
# false skips LDAP TLS certificate verification.
LDAP_REJECT_UNAUTHORIZED=true

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Pino log level: fatal, error, warn, info, debug, trace. Default info.
LOG_LEVEL="info"

# Hostnames the SSR server accepts in the Host header.
# Comma-separated, or * for any host (typical on a LAN).
# ALLOWED_HOSTS is an alias if NG_ALLOWED_HOSTS is unset.
# Default when both are unset: localhost,127.0.0.1
NG_ALLOWED_HOSTS=*
# ALLOWED_HOSTS=*

# Bind address and port for `npm run serve:ssr:qmsangular`.
# Defaults: 0.0.0.0 and 4000. `npm start` uses the Angular dev server on 4200.
HOST=0.0.0.0
PORT=4000

# Set by the runtime (development under ng serve, production for a built server).
# You do not normally put this in .env. It selects dev CSP and cookie defaults.
# NODE_ENV=development
